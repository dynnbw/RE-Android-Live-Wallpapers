.continue/

# Gradle / Android build artifacts
.gradle/
**/build/
captures/
*.apk
*.aab
*.ap_
*.dex

# Local machine config / secrets
local.properties
gradle.properties
# 例外：CI 用的那份要提交 —— 它只有非机密项（本机那份含正式签名口令，仍然忽略）。
# 上面那条没有斜杠，会在任何层级匹配，所以这里必须显式放行。
!ci/gradle.properties
*.jks
*.keystore
# 例外：夜间通道的调试密钥库要提交进仓库（公开密钥，只签包名带 .nightly 的包）。
# 见 app/build.gradle 的 signingConfigs.debug 与 scripts/ci_checks.py 的 NIGHTLY_KEYSTORE。
!debug.keystore

# Logs and temp files
*.log
build_output.txt
luminousdots_log.txt
luminousdots_full_log.txt

# Large local-only resources / notes
web_version/
docs/
tools/

# Local git identity switching config
git-identity.config.ps1

# Local git identity helper scripts
git-identity-switch.ps1
git-identity.config.example.ps1
use-work-git.bat
use-personal-git.bat
show-git-identity.bat