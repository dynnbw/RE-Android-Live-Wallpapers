<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#090A1E"
                android:startColor="#1D103B" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="5dp" android:top="8dp" android:right="13dp" android:bottom="18dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#88A6F8FF"
                android:endColor="#00A6F8FF"
                android:gradientRadius="18dp"
                android:startColor="#66FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="7dp" android:bottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#88FF7A9F"
                android:endColor="#00FF7A9F"
                android:gradientRadius="16dp"
                android:startColor="#44FFDDAA"
                android:type="radial" />
        </shape>
    </item>
    <item android:left="22dp" android:top="6dp" android:right="18dp" android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="#E6FFFFFF" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
    <item android:left="30dp" android:top="16dp" android:right="10dp" android:bottom="12dp">
        <shape android:shape="oval">
            <solid android:color="#CCF5F3FF" />
            <size android:width="2dp" android:height="2dp" />
        </shape>
    </item>
</layer-list>