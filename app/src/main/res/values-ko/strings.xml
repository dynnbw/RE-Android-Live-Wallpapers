    <string name="wallpaper_flsorescence_desc">빛나는 점들이 화면에서 생명체처럼 부드럽게 움직입니다.</string>

    <string name="wallpaper_grass">하늘과 풀밭</string>
    <string name="wallpaper_grass_vk">하늘과 풀밭 Vulkan</string>
    <string name="wallpaper_grass_author">Google</string>
    <string name="wallpaper_grass_desc">풀잎들이 낮이나 밤하늘 아래에서 부드럽게 흔들립니다.</string>
