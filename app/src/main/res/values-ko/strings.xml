    <string name="wallpaper_wildworld">야생 세계</string>
    <string name="wallpaper_wildworld_author">MediaTek</string>
    <string name="wallpaper_wildworld_desc">층층이 움직이는 선사 시대 풍경과 장난기 있는 생명체들.</string>

    <string name="wallpaper_fireworks">불꽃놀이</string>
    <string name="wallpaper_fireworks_author">MediaTek</string>
    <string name="wallpaper_fireworks_desc">화려한 불꽃이 밤하늘에 터집니다.</string>

    <string name="wallpaper_windmill">회전하는 풍차</string>
    <string name="wallpaper_windmill_author">MediaTek</string>
    <string name="wallpaper_windmill_desc">역동적인 날씨 속의 구릉과 회전하는 풍차.</string>

    <string name="wallpaper_ocean">해양 날씨</string>
    <string name="wallpaper_ocean_author">MediaTek</string>
    <string name="wallpaper_ocean_desc">실제 날씨에 따라 변화하는 파도와 하늘.</string>

    <string name="wallpaper_deepsea">깊은 바다</string>
    <string name="wallpaper_deepsea_author">Samsung</string>
    <string name="wallpaper_deepsea_desc">반투명 해파리가 깊은 바다에서 천천히 움직입니다.</string>

    <string name="wallpaper_clock">극지 시계</string>
    <string name="wallpaper_clock_author">Google</string>
    <string name="wallpaper_clock_desc">시계 방향 원호로 날짜와 시간을 표시합니다: 월, 일, 시, 분, 초.</string>

    <string name="wallpaper_aurora1">북극광</string>
    <string name="wallpaper_aurora1_author">TAT</string>
    <string name="wallpaper_aurora1_desc">층을 이루며 흐르는 오로라가 별이 빛나는 배경을 덮고, 터치 입자 상호작용을 지원합니다.</string>
    <string name="wallpaper_aurora2">북극광 2</string>
    <string name="wallpaper_aurora2_author">HU1</string>
    <string name="wallpaper_aurora2_desc">테마 야경 위의 오로라 커튼이 계속해서 물결치며, 반짝이는 별과 유성 애니메이션이 함께합니다.</string>

    <string name="wallpaper_nexus">교차하는 빛의 장막</string>
    <string name="wallpaper_nexus_author">Google</string>
    <string name="wallpaper_nexus_desc">신경망의 한 단면.</string>

    <string name="wallpaper_noisefield">거품</string>
    <string name="wallpaper_noisefield_author">Google</string>
    <string name="wallpaper_noisefield_desc">부드러운 그라데이션 배경 위에 빛나는 거품이 흐릅니다.</string>

    <string name="wallpaper_nebula">성운</string>
    <string name="wallpaper_nebula_author">念.</string>
    <string name="wallpaper_nebula_desc">공식 기반 실시간 볼륨 렌더링으로 구현한 오리온 대성운의 시각 효과.</string>

