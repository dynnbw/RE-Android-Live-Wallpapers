<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 注意：md_theme_primary 在本配色里是"浅色面"色（浅色模式下与 surface 同色），
         当作文字色会与背景同色、看不见；文字请用 md_theme_control / md_theme_onSurface -->
    <color name="md_theme_primary">#F0FFFF</color>
    <color name="md_theme_onPrimary">#2F4F4F</color>
    <color name="md_theme_primaryContainer">#F0FFFF</color>
    <color name="md_theme_onPrimaryContainer">#2F4F4F</color>
    <color name="md_theme_secondary">#F0FFFF</color>
    <color name="md_theme_onSecondary">#2F4F4F</color>
    <color name="md_theme_control">#1F5B5B</color>
    <color name="md_theme_controlHighlight">#335B5B</color>
    <color name="md_theme_background">#F0FFFF</color>
    <color name="md_theme_onBackground">#2F4F4F</color>
    <color name="md_theme_surface">#F0FFFF</color>
    <!-- 半透明 surface（75% 不透明），用于全屏预览上的设置抽屉 -->
    <color name="md_theme_surface_translucent">#BFF0FFFF</color>
    <color name="md_theme_onSurface">#2F4F4F</color>
    <!-- 壁纸磁贴占位格（反馈入口）的主题色底与前景：浅色模式下深青底 + 浅字 -->
    <color name="md_theme_cta_container">#1F5B5B</color>
    <color name="md_theme_cta_onContainer">#F0FFFF</color>
    <color name="colorPrimary">#2196F3</color>
    <color name="colorPrimaryDark">#1976D2</color>
    <color name="colorAccent">#FF4081</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="cardview_light_background">#FFFFFFFF</color>
</resources>
