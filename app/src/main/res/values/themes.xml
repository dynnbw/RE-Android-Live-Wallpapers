<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WallpaperSettings" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorPrimaryDark">@color/md_theme_primary</item>
        <item name="android:statusBarColor">@color/md_theme_primary</item>
        <item name="colorAccent">@color/md_theme_secondary</item>
        <item name="colorControlActivated">@color/md_theme_control</item>
        <item name="colorControlHighlight">@color/md_theme_controlHighlight</item>
        <item name="android:colorAccent">@color/md_theme_secondary</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurface</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.WallpaperSettings.AppCompatDialog</item>
    </style>

    <style name="ThemeOverlay.WallpaperSettings.AppCompatDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_card</item>
        <item name="colorPrimary">@color/md_theme_control</item>
        <item name="colorAccent">@color/md_theme_control</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="textColorAlertDialogListItem">@color/md_theme_onSurface</item>
        <item name="android:textColorAlertDialogListItem">@color/md_theme_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.WallpaperSettings.DialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.WallpaperSettings.DialogBody" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Widget.WallpaperSettings.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/md_theme_control</item>
    </style>

    <style name="ThemeOverlay.WallpaperSettings.ToolbarPopup" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">@drawable/bg_toolbar_popup_menu</item>
        <item name="android:popupElevation">12dp</item>
        <item name="popupMenuStyle">@style/Widget.WallpaperSettings.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.WallpaperSettings.OverflowMenu</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurface</item>
        <item name="colorControlNormal">@color/md_theme_onSurface</item>
    </style>

    <style name="Widget.WallpaperSettings.PopupMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_toolbar_popup_menu</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WallpaperSettings.PopupMenu</item>
    </style>

    <style name="Widget.WallpaperSettings.OverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_toolbar_popup_menu</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WallpaperSettings.PopupMenu</item>
    </style>

    <style name="TextAppearance.WallpaperSettings.PopupMenu" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

</resources>
