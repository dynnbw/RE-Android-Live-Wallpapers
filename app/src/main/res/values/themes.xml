<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WallpaperSettings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorPrimaryDark">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="android:statusBarColor">@color/md_theme_primary</item>
        <item name="colorAccent">@color/md_theme_control</item>
        <item name="colorControlActivated">@color/md_theme_control</item>
        <item name="colorControlHighlight">@color/md_theme_controlHighlight</item>
        <item name="android:colorAccent">@color/md_theme_control</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurface</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WallpaperSettings.AlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.WallpaperSettings.AppCompatDialog</item>
    </style>

    <style name="ThemeOverlay.WallpaperSettings.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.WallpaperSettings.Dialog</item>
        <item name="backgroundInsetStart">24dp</item>
        <item name="backgroundInsetEnd">24dp</item>
        <item name="backgroundInsetTop">24dp</item>
        <item name="backgroundInsetBottom">24dp</item>
        <item name="colorPrimary">@color/md_theme_control</item>
        <item name="colorSecondary">@color/md_theme_control</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.WallpaperSettings.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.WallpaperSettings.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="textColorAlertDialogListItem">@color/md_theme_onSurface</item>
        <item name="android:textColorAlertDialogListItem">@color/md_theme_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurface</item>
    </style>

    <style name="ThemeOverlay.WallpaperSettings.AppCompatDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_card</item>
        <item name="colorPrimary">@color/md_theme_control</item>
        <item name="colorAccent">@color/md_theme_control</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.WallpaperSettings.DialogButton</item>
        <item name="textColorAlertDialogListItem">@color/md_theme_onSurface</item>
        <item name="android:textColorAlertDialogListItem">@color/md_theme_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.WallpaperSettings.DialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.WallpaperSettings.DialogBody" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Widget.WallpaperSettings.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/md_theme_control</item>
    </style>

    <style name="ShapeAppearanceOverlay.WallpaperSettings.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
