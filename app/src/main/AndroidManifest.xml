<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <original-package android:name="com.reandroid.wallpaper" />

    <uses-feature android:name="android.software.live_wallpaper" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.BIND_WALLPAPER" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:label="@string/wallpapers"
        android:icon="@drawable/ic_launcher_wallpaper">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Main Settings -->
        <activity
            android:exported="true"
            android:label="@string/settings_title"
            android:name="com.reandroid.settings.SettingsActivity"
            android:theme="@style/Theme.WallpaperSettings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:exported="true"
            android:label="@string/about_title"
            android:name="com.reandroid.settings.AboutActivity"
            android:theme="@style/Theme.WallpaperSettings" />

        <activity
            android:exported="false"
            android:label="@string/pref_apply_api_title"
            android:name="com.reandroid.settings.OpenWeatherApiGuideActivity"
            android:theme="@style/Theme.WallpaperSettings" />

        <!-- Generic plugin settings (system wallpaper preview Settings button) -->
        <activity
            android:name="com.reandroid.settings.PluginSettingsActivity"
            android:theme="@style/Theme.WallpaperSettings"
            android:exported="true" />

        <!-- Standalone Polar Clock settings -->
        <activity
            android:label="@string/clock_settings"
            android:name="com.reandroid.wallpaper.polarclock.PolarClockSettings"
            android:theme="@style/Theme.WallpaperSettings"
            android:exported="true"
            android:enabled="@bool/config_enable_polar_clock_wallpaper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Test activities (launchable via adb) -->
        <activity android:exported="true" android:label="@string/wallpaper_grass" android:name="com.reandroid.wallpaper.grass.Grass" android:theme="@android:style/Theme.NoTitleBar" android:enabled="@bool/config_enable_grass_wallpaper">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.TEST" /></intent-filter>
        </activity>
        <activity android:exported="true" android:label="@string/wallpaper_grass_vk" android:name="com.reandroid.wallpaper.grass.GrassVK" android:theme="@android:style/Theme.NoTitleBar" android:enabled="@bool/config_enable_grass_wallpaper">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.TEST" /></intent-filter>
        </activity>
        <activity android:exported="true" android:label="@string/wallpaper_aurora1" android:name="com.reandroid.wallpaper.aurora1.Aurora1" android:theme="@android:style/Theme.NoTitleBar" android:enabled="@bool/config_enable_aurora1_wallpaper">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.TEST" /></intent-filter>
        </activity>
        <activity android:exported="true" android:label="@string/wallpaper_aurora2" android:name="com.reandroid.wallpaper.aurora2.Aurora2" android:theme="@android:style/Theme.NoTitleBar" android:enabled="@bool/config_enable_aurora2_wallpaper">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.TEST" /></intent-filter>
        </activity>
        <activity android:exported="true" android:label="@string/wallpaper_galaxy" android:name="com.reandroid.wallpaper.galaxy.Galaxy" android:theme="@android:style/Theme.NoTitleBar" android:enabled="@bool/config_enable_galaxy_wallpaper">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.TEST" /></intent-filter>
        </activity>
        <activity android:exported="true" android:label="@string/wallpaper_galaxy_vk" android:name="com.reandroid.wallpaper.galaxy.GalaxyVK" android:theme="@android:style/Theme.NoTitleBar" android:enabled="@bool/config_enable_galaxy_wallpaper">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.TEST" /></intent-filter>
        </activity>
        <activity android:exported="true" android:label="@string/wallpaper_fall" android:name="com.reandroid.wallpaper.fall.Fall" android:theme="@android:style/Theme.NoTitleBar" android:enabled="@bool/config_enable_fall_wallpaper">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.TEST" /></intent-filter>
        </activity>
        <activity android:exported="true" android:label="@string/wallpaper_fall_vk" android:name="com.reandroid.wallpaper.fall.FallVK" android:theme="@android:style/Theme.NoTitleBar" android:enabled="@bool/config_enable_fall_wallpaper">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.TEST" /></intent-filter>
        </activity>

        <!-- === Single wallpaper service (plugin architecture) === -->
        <service
            android:name="com.reandroid.plugin.ProxyWallpaperService"
            android:exported="true"
            android:label="@string/wallpapers"
            android:permission="android.permission.BIND_WALLPAPER"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/proxy_wallpaper" />
        </service>

    </application>

</manifest>
