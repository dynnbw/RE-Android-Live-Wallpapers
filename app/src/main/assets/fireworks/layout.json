{
  "prefs": [
    {
      "type": "seekbar",
      "key": "pref_fireworks_count",
      "title": "pref_fireworks_count_title",
      "summary": "pref_fireworks_count_summary",
      "default": 2,
      "min": 1,
      "max": 30
    },
    {
      "type": "switch",
      "key": "pref_fireworks_tails",
      "title": "pref_fireworks_tails_title",
      "summary": "pref_fireworks_tails_summary",
      "default": true
    },
    {
      "type": "list",
      "key": "pref_fireworks_palette",
      "title": "pref_fireworks_palette_title",
      "summary": "pref_fireworks_palette_summary",
      "default": "original",
      "values": ["original", "vivid"],
      "labels": [
        "pref_fireworks_palette_label_original",
        "pref_fireworks_palette_label_vivid"
      ]
    },
    {
      "type": "switch",
      "key": "pref_fireworks_enhanced",
      "title": "pref_fireworks_enhanced_title",
      "summary": "pref_fireworks_enhanced_summary",
      "default": false
    },
    {
      "type": "switch",
      "key": "pref_fireworks_grass_night",
      "title": "@string/pref_fireworks_grass_night_title",
      "summary": "@string/pref_fireworks_grass_night_summary",
      "default": "false"
    },
    {
      "type": "button",
      "key": "pref_custom_background",
      "title": "@string/pref_fireworks_custom_background_title",
      "summary": "@string/pref_fireworks_custom_background_summary",
      "action": "pickBackground",
      "disableOn": "pref_fireworks_grass_night"
    },
    {
      "type": "button",
      "key": "pref_reset_background",
      "title": "@string/pref_fireworks_reset_background_title",
      "summary": "@string/pref_fireworks_reset_background_summary",
      "action": "resetBackground",
      "disableOn": "pref_fireworks_grass_night"
    }
  ]
}
